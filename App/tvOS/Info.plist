<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<!-- iOS picks the app's language from what the *app bundle* declares, not
	     from what its packages contain. Without this the string catalogs are
	     never consulted and every device falls back to English. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>nb</string>
	</array>
	<key>CFBundleDisplayName</key>
	<string>Kanal</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Kanal uses your local network to receive a playlist from your iPhone. Nothing is sent over the internet.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_kanal-pair._tcp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<!-- Supplied by Config/Secrets.xcconfig; empty is fine and simply keeps
	     Kanal's search local-only. -->
	<key>TMDBAPIKey</key>
	<string>$(TMDB_API_KEY)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
