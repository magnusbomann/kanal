<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Kanal collects nothing. Playlists, credentials, favourites and watch
	     history are written to the app's own container and never leave the
	     device except to the user's own provider. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- No required-reason APIs are used: no UserDefaults, no file timestamps,
	     no disk space, no boot time, no active keyboard. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
