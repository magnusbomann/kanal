    "pairing.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء يترك شبكة منزلك الرمز جديد كل مرة ويتوقف عن العمل لحظة إغلاق هذه الشاشة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kode forlader dit hjemmenetværk. Koden er altid ny, og den stopper med at virke, så snart denne skærm lukkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts verlässt Ihr Heimnetzwerk. Der Code ist jedes Mal neu und hört zu funktionieren, sobald dieser Bildschirm geschlossen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing leaves your home network. The code is new every time and stops working the moment this screen closes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sale de tu red doméstica. El código es nuevo cada vez y deja de funcionar en el momento en que se cierra esta pantalla."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikään ei poistu kotiverkostasi. Koodi on uusi joka kerta ja lakkaa toimimasta, kun tämä näyttö sulkeutuu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne quitte votre réseau domestique. Le code est nouveau à chaque fois et cesse de fonctionner dès la fermeture de cet écran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente lascia la tua rete domestica. Il codice è nuovo ogni volta e smette di funzionare nel momento in cui questa schermata si chiude."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting forlater hjemmenettet ditt. Koden er ny hver gang og slutter å virke i det denne skjermen lukkes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets verlaat uw thuisnetwerk. De code is elke keer nieuw en stopt met werken op het moment dat dit scherm wordt gesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie opuszcza twojej sieci. Kod jest nowy za każdym razem i przestaje działać w momencie zamknięcia ekranu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada sai da sua rede doméstica. O código é sempre novo e para de funcionar no momento em que a tela é fechada."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting lämnar ditt hemnätverk. Koden är ny varje gång och slutar fungera i det ögonblick som den här skärmen stängs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey ev ağınızı terk etmez. Kod her seferinde yenidir ve bu ekran kapandığı anda çalışmayı bırakır."
          }
        }
      }
    },
