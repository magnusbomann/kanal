    "player.unsupported.body %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الفيلم هو %@. لاعب (آبل) يفتح فقط MP4 و MOV و نسق التنقية التلفزيونية الحية لأنه متدفق إسأل مُقدّمك ما إذا كان بإمكانهم تقديم أفلام كـ\"إتش إل إس\" أو \"إم 4\""
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne film serveres som %@. Apples afspiller åbner kun MP4-, MOV- og streamingformater — live-tv fungerer, fordi det er streamet. Spørg din udbyder, om de kan servere film som HLS eller MP4."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Film wird als %@ angeboten. Apples Player öffnet nur MP4-, MOV- und Streamingformate - Live-TV funktioniert, weil es gestreamt wird. Fragen Sie Ihren Anbieter, ob er Filme als HLS oder MP4 anbieten kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This film is served as %@. Apple's player only opens MP4, MOV and streaming formats — live TV works because it is streamed. Ask your provider whether they can serve films as HLS or MP4."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta película se publica como %@. El reproductor de Apple solo abre formatos MP4, MOV y streaming; la televisión en vivo funciona porque se transmite por streaming. Pregunte a su proveedor si pueden reproducir películas en formato HLS o MP4."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä elokuva on %@. Applen pelaaja avaa vain MP4, MOV- ja streaming-formaatteja, koska se on streamed. Kysy tarjoajaltasi, voivatko he tarjota elokuvia HLS:nä tai MP4:nä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce film est servi sous le nom de %@. Le lecteur Apple n'ouvre que les formats MP4, MOV et streaming : la télévision en direct fonctionne car elle est diffusée en streaming. Demandez à votre fournisseur s'il peut diffuser des films au format HLS ou MP4."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo film viene fornito come %@. Il lettore di Apple apre solo i formati MP4, MOV e streaming: la TV in diretta funziona perché viene trasmessa in streaming. Chiedi al tuo fornitore se può fornire film come HLS o MP4."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne filmen leveres som %@. Apples spiller åpner bare MP4, MOV og strømmeformater — direkte-TV virker fordi det strømmes. Spør leverandøren om de kan levere filmer som HLS eller MP4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze film wordt geserveerd als %@. De Apple-speler opent alleen MP4-, MOV- en streamingformaten - live tv werkt omdat het wordt gestreamd. Vraag uw provider of ze films kunnen serveren als HLS of MP4."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten film to %@. Gracz Apple 'a otwiera tylko formaty MP4, MOV i streaming - działa na żywo, ponieważ jest transmitowany. Zapytaj swojego dostawcy, czy mogą one służyć filmy jako HLS lub MP4."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este filme é apresentado como %@. O player da Apple só abre formatos MP4, MOV e streaming – a TV ao vivo funciona porque é transmitida. Pergunte ao seu provedor se eles podem veicular filmes como HLS ou MP4."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna film spelas som %@. Apples spelare öppnar bara MP4-, MOV- och streamingformat – live-TV fungerar eftersom den streamas. Fråga din leverantör om de kan spela filmer som HLS eller MP4."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu film %@ olarak sunulur. Apple'ın oynatıcısı yalnızca MP4, MOV ve akış formatlarını açar - canlı TV akış olduğu için çalışır. Sağlayıcınızın filmleri HLS veya MP4 olarak sunup sunamayacağını sorun."
          }
        }
      }
    },
    "player.unsupported.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزودك يرسل هذا في شكل لا يستطيع (آبل) فتحه"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
