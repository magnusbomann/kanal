    "credit.vlc.purpose": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعزف الفيلم و أشكال السلسلات لا يمكن للاعب آبل أن يفتح مثل MKV."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspiller film- og serieformater, som Apples egen afspiller ikke kan åbne, såsom MKV."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielt Film- und Serienformate ab, die Apples eigener Player nicht öffnen kann, wie z. B. MKV."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the film and series formats Apple's own player cannot open, such as MKV."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduce formatos de películas y series que el reproductor propio de Apple no puede abrir, como por ejemplo MKV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelaa elokuvaa ja sarjaformaatteja Applen oma pelaaja ei voi avata, kuten MKV."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les formats de films et de séries que le lecteur Apple ne peut pas ouvrir, comme MKV."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riproduce i formati di film e serie che il lettore di Apple stesso non può aprire, come MKV."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller av film- og serieformatene Apples egen spiller ikke kan åpne, som MKV."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Speelt de film- en serieformaten af die de eigen speler van Apple niet kan openen, zoals MKV."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarza formaty filmów i seriali, których własny gracz Apple nie może otworzyć, np. MKV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reproduz os formatos de filmes e séries que o próprio player da Apple não consegue abrir, como MKV."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar filmer och serier i format som Apples egen spelare inte kan öppna, till exempel MKV."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MKV gibi Apple'ın kendi oynatıcısı açamadığı film ve dizi formatlarını oynatır."
          }
        }
      }
    },
    "credit.wikidata.purpose": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعك من البحث عن فيلم بالاسم الذي تعرفه به مهما كانت اللغة التي استخدمها مقدمك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan søge efter en film ved det navn, du kender den ved, uanset hvilket sprog din udbyder har brugt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie ermöglicht es Ihnen, einen Film nach dem Namen zu suchen, den Sie ihn kennen, unabhängig davon, welche Sprache Ihr Anbieter verwendet hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you search for a film by the name you know it by, whatever language your provider used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le permite buscar una película por el nombre que conoce, independientemente del idioma que utilice su proveedor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen avulla voit etsiä elokuvan nimellä tiedät sen, mitä kieltä palveluntarjoaja käyttää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous permet de rechercher un film par le nom sous lequel vous le connaissez, quelle que soit la langue utilisée par votre fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti permette di cercare un film dal nome che lo conosci, indipendentemente dalla lingua utilizzata dal tuo provider."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar deg søke etter en film med navnet du kjenner den som, uansett hvilket språk leverandøren brukte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat je een film zoeken op de naam die je ervan kent, ongeacht de taal die je provider heeft gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwala na wyszukiwanie filmu pod nazwą, którą znasz, bez względu na język, jakim posłużył się dostawca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que você pesquise um filme pelo nome que você conhece, independentemente do idioma usado pelo seu provedor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan söka efter en film efter det namn du känner till den, oavsett vilket språk din leverantör använde."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Size sağlayıcınızın kullandığı dilde ne kadar biliniyorsa bilin, bir filmin adını kullanarak arama yapmanızı sağlar."
          }
        }
      }
    },
