    "profiles.hidden.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal يخفي أي شيء دون تقدير العمر في أو أقل من هذا الرقم أضف أجزاء في هذا الملف لتوسيع ما يتم فحصه"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal skjuler alt indhold uden aldersgrænse på eller under denne profils grænse. Tilføj sektioner i denne profil for at udvide det, der tjekkes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal versteckt alles, was keine Altersfreigabe hat, bis zu oder unter dem Limit dieses Profils. Füge Abschnitte in diesem Profil hinzu, um zu erweitern, was überprüft wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal hides anything without an age rating at or below this profile's limit. Add sections in this profile to widen what gets checked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal oculta cualquier cosa sin una clasificación de edad igual o inferior al límite de este perfil. Agregue secciones en este perfil para ampliar lo que se verifica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal piilottaa mitään ilman ikärajaa tämän profiilin rajalle tai sen alapuolelle. Lisää osiot tähän profiiliin laajentaa mitä tarkistetaan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal masque tout ce qui n'a pas de limite d'âge égale ou inférieure à la limite de ce profil. Ajoutez des sections dans ce profil pour élargir ce qui est vérifié."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal nasconde qualsiasi contenuto senza una valutazione di età pari o inferiore al limite di questo profilo. Aggiungi sezioni a questo profilo per ampliare ciò che viene controllato."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal skjuler alt uten en aldersgrense på eller under grensen for denne profilen. Legg til kategorier i profilen for å utvide hva som sjekkes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal verbergt alles zonder een leeftijdsbeoordeling op of onder het limiet van dit profiel. Voeg secties toe in dit profiel om uit te breiden wat wordt gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal ukrywa wszystko bez oceny wieku na poziomie lub poniżej limitu tego profilu. Dodaj sekcje w tym profilu, aby poszerzyć to, co jest zaznaczone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal oculta qualquer coisa sem classificação etária igual ou inferior ao limite deste perfil. Adicione seções neste perfil para ampliar o que é verificado."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal döljer allt innehåll utan åldersgräns som ligger under eller lägre än profilsgränsen. Lägg till sektioner i den här profilen för att bredda vad som granskas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal, bu profilin sınırının altında veya altında yaş derecelendirmesi olmayan her şeyi gizler. Kontrol edilen şeyleri genişletmek için bu profildeki bölümler ekleyin."
          }
        }
      }
    },
