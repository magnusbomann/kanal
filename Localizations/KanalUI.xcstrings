    "player.unsupported.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider sends this in a format Apple can't open"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandøren sender denne i et format Apple ikke kan åpne"
          }
        }
      }
    },
    "player.unsupported.body %@": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This film is served as %@. Apple's player only opens MP4, MOV and streaming formats — live TV works because it is streamed. Ask your provider whether they can serve films as HLS or MP4."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne filmen leveres som %@. Apples spiller åpner bare MP4, MOV og strømmeformater — direkte-TV virker fordi det strømmes. Spør leverandøren om de kan levere filmer som HLS eller MP4."
          }
        }
      }
    },
    "player.server.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server can't be streamed from"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne serveren kan det ikke strømmes fra"
          }
        }
      }
    },
    "player.server.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file downloads, but the server won't serve it in pieces, so there is nothing to play or skip through."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fila lastes ned, men serveren vil ikke levere den i biter, så det er ingenting å spille av eller hoppe i."
          }
        }
      }
    },
    "player.rejected.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider refused this"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandøren avviste dette"
          }
        }
      }
    },
    "player.rejected.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription may have expired, or you may already be watching on as many devices as it allows."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementet kan ha utløpt, eller du ser kanskje allerede på så mange enheter som det tillater."
          }
        }
      }
    },
    "player.offline.title": {
      "extractionState": "manual",
