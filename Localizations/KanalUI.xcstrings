          }
        }
      }
    },
    "intro.1.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal هو لاعب لخدمات التلفزيون التي تدفعها بالفعل. إنه لا يبيع القنوات أو يقدم أي منها بل يجعل من سعدك مشاهدته"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er en spiller til den tv-tjeneste, du allerede betaler for. Den sælger ikke kanaler eller leverer nogen – den gør blot din egen behagelig at se på."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal ist ein Spieler für den Fernsehsender, für den Sie bereits bezahlen. Er verkauft keine Kanäle oder bietet auch keine an - er macht einfach Ihren Sender angenehm zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is a player for the TV service you already pay for. It doesn't sell channels or provide any — it simply makes yours pleasant to watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal es un reproductor para el servicio de TV que ya pagas. No vende canales ni proporciona ninguno; simplemente hace que el suyo sea agradable de ver."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal on jo maksamasi TV-palvelun pelaaja. Se ei myy kanavia tai tarjota mitään ... se yksinkertaisesti tekee sinun miellyttävä katsella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal est un lecteur pour le service TV pour lequel vous payez déjà. Il ne vend pas de chaînes et n'en fournit pas, il rend simplement la vôtre agréable à regarder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal è un giocatore per il servizio TV per il quale già paghi. Non vende canali né fornisce alcun canale: semplicemente rende il tuo piacevole da guardare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er en avspiller for TV-tjenesten du allerede betaler for. Den selger eller leverer ingen kanaler — den gjør bare dine hyggelige å se på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is een speler voor de tv-dienst waarvoor je al betaalt. Het verkoopt geen kanalen of biedt er geen aan - het maakt gewoon je eigen kanaal aangenaam om naar te kijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal jest graczem dla usług telewizyjnych, za które już płacisz. Nie sprzedaje kanałów ani nie zapewnia żadnych - to po prostu sprawia, że twoje przyjemne oglądać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal é um reprodutor do serviço de TV pelo qual você já paga. Ele não vende canais nem fornece nenhum - simplesmente torna o seu agradável de assistir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal är en spelare för den TV-tjänst du redan betalar för. Den säljer inga kanaler eller tillhandahåller några – den gör bara din TV-tjänst trevligare att titta på."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal, zaten ödediğiniz TV hizmetinin bir oyuncusudur. Kanal satmaz veya herhangi bir şey sağlamaz - sadece izlenmesini keyifli hale getirir."
          }
        }
      }
    },
