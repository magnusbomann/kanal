    "stream.stopped.body": {
      "extractionState": "manual",
      "comment": "Live stream selection and recovery",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic search has stopped. Retry this stream or choose one from the list."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk søk er stoppet. Prøv denne streamen igjen, eller velg en fra listen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk sökning har stoppats. Försök igen eller välj en ström i listan."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisk søgning er stoppet. Prøv igen, eller vælg en stream fra listen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Suche wurde beendet. Versuche diesen Stream erneut oder wähle einen aus der Liste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche automatique est terminée. Réessayez ce flux ou choisissez-en un dans la liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda automática se ha detenido. Reintenta esta transmisión o elige una de la lista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca automática foi interrompida. Tente esta transmissão novamente ou escolha uma da lista."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca automatica è terminata. Riprova questo flusso o scegline uno dalla lista."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch zoeken is gestopt. Probeer deze stream opnieuw of kies er een uit de lijst."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen haku on päättynyt. Yritä uudelleen tai valitse suoratoisto luettelosta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczne wyszukiwanie zostało zatrzymane. Spróbuj ponownie lub wybierz strumień z listy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatik arama durduruldu. Bu yayını yeniden deneyin veya listeden bir yayın seçin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف البحث التلقائي. أعد محاولة هذا البث أو اختر بثًا من القائمة."
          }
        }
      }
    },
