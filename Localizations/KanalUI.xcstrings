        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nopeammin kuin kaukosäätimellä. Tai liitä linkki alla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rapide que de taper avec la télécommande. Ou collez le lien ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più veloce di digitare con il telecomando. Oppure incolla il link qui sotto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskere enn å taste med fjernkontrollen. Eller lim inn lenken nedenfor."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sneller dan typen met de afstandsbediening. Of plak de onderstaande link in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybciej niż pisanie na pilocie. Albo wklej link poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
