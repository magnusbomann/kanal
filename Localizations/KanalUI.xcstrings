    "intro.2.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خدمتك التلفزيونية أعطتك وصلة أو تفاصيل للتوقيع عندما كنت مشترك - عادة بالبريد الإلكتروني. ابحثوا عن هذه الرسالة و Kanal يتعاملون مع الباقي: تلفزيون حي، أفلام، سلسلة ودليل، فرز تلقائيا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når du tilmeldte dig dit TV-abonnement, modtog du normalt en e-mail med en link eller loginoplysninger. Find denne e-mail, og Kanal tager sig af resten: live-tv, film, serier og vejledningen, alt sammen sorteret automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr TV-Dienst hat Ihnen bei der Anmeldung einen Link oder Anmeldedaten gegeben - normalerweise per E-Mail. Finden Sie diese Nachricht und Kanal kümmert sich um den Rest: Live-TV, Filme, Serien und der Guide, automatisch sortiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your TV service gave you a link or sign-in details when you subscribed — usually by email. Find that message and Kanal handles the rest: live TV, films, series and the guide, sorted automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su servicio de TV le proporcionó un enlace o detalles de inicio de sesión cuando se suscribió, generalmente por correo electrónico. Encuentra ese mensaje y Kanal se encarga del resto: TV en vivo, películas, series y la guía, ordenados automáticamente."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-palvelusi antoi sinulle linkin tai kirjautumistiedot, kun tilasit yleensä sähköpostitse. Etsi tämä viesti ja Kanal käsittelee loput: live-tv, elokuvat, sarja ja opas, järjestetty automaattisesti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre service de télévision vous a fourni un lien ou des informations de connexion lors de votre abonnement, généralement par e-mail. Trouvez ce message et Kanal s'occupe du reste : la télévision en direct, les films, les séries et le guide, triés automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo servizio TV ti ha fornito un link o i dettagli di accesso quando ti sei iscritto, di solito via e-mail. Trova quel messaggio e Kanal si occupa del resto: TV in diretta, film, serie e la guida, ordinati automaticamente."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-tjenesten din ga deg en lenke eller innloggingsopplysninger da du tegnet abonnement — som regel på e-post. Finn den meldingen, så ordner Kanal resten: direkte-TV, filmer, serier og TV-guiden, sortert av seg selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw tv-service gaf u een link of aanmeldgegevens toen u zich abonneerde - meestal per e-mail. Zoek dat bericht en Kanal zorgt voor de rest: live tv, films, series en de gids, automatisch gesorteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwis telewizyjny dał Ci link lub sign- w szczegółach, gdy subskrybowany - zazwyczaj przez e-mail. Znajdź tę wiadomość i Kanal obsługuje resztę: TV na żywo, filmy, serial i przewodnik, sortowane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu serviço de TV forneceu um link ou detalhes de login quando você se inscreveu – geralmente por e-mail. Encontre essa mensagem e Kanal cuida do resto: TV ao vivo, filmes, séries e guia, classificados automaticamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du prenumererade på din TV-tjänst fick du vanligtvis en länk eller inloggningsuppgifter via e-post. Hitta det meddelandet, så tar Kanal hand om resten: live-TV, filmer, serier och programguiden, allt sorterat automatiskt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik yaptığınızda TV hizmetiniz size bir bağlantı veya oturum açma bilgileri verdi - genellikle e-posta yoluyla. O mesajı bulun ve Kanal geri kalanını otomatik olarak yönetir: canlı TV, filmler, diziler ve kılavuz, otomatik olarak sıralanır."
          }
        }
      }
    },
