    "sources.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزودك يحمل هذه القناة على عدة مسارات، وليس كل منهم يعمل. Kanal يحاول أن يفعلوا ذلك ويتذكر الشخص الذي لعب"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din udbyder sender denne kanal på flere kanaler, og ikke alle fungerer. Kanal prøver dem efter hinanden og husker den, der spillede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Anbieter bietet diesen Kanal auf mehreren Sendern an, und nicht alle funktionieren. Kanal versucht sie abwechselnd und erinnert sich an den, der abgespielt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider carries this channel on several streams, and not all of them work. Kanal tries them in turn and remembers the one that played."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su proveedor ofrece este canal en varias transmisiones y no todas funcionan. Kanal los prueba por turno y recuerda el que jugó."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palveluntarjoajasi kuljettaa tätä kanavaa useissa puroissa, eivätkä kaikki ne toimivat. Kanal yrittää niitä vuorotellen ja muistaa sen, joka soitti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fournisseur diffuse cette chaîne sur plusieurs flux, et tous ne fonctionnent pas. Kanal les essaie à tour de rôle et se souvient de celui qui a joué."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo provider trasmette questo canale su diversi canali, e non tutti funzionano. Kanal li prova a turno e ricorda quello che ha suonato."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandøren din fører denne kanalen på flere strømmer, og ikke alle virker. Kanal prøver dem etter tur og husker den som spilte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw provider draagt dit kanaal op verschillende streams, en niet alle werken. Kanal probeert ze om de beurt en onthoudt degene die speelde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dostawca nosi ten kanał na kilku strumieniach, a nie wszystkie z nich działają. Kanal próbuje ich z kolei i pamięta ten, który grał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu provedor carrega esse canal em vários streams e nem todos funcionam. Kanal tenta-os por sua vez e lembra-se daquele que tocou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din leverantör sänds denna kanal på flera kanaler, och inte alla fungerar. Kanal försöker dem i tur och ordning och kommer ihåg den som spelades."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satıcınız bu kanalı birkaç akışta taşır ve bunların hepsi çalışmaz. Kanal onları sırayla denir ve oynanan olanı hatırlar."
          }
        }
      }
    },
