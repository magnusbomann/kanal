    "intro.1.top": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "YOUR TV."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "DIN TV."
          }
        }
      }
    },
    "intro.1.bottom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FINALLY PLEASANT."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "ENDELIG BEHAGELIG."
          }
        }
      }
    },
    "intro.1.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is a player for the IPTV subscription you already pay for. It doesn't sell channels and doesn't provide any — it just makes the ones you have pleasant to watch."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er en avspiller for IPTV-abonnementet du allerede betaler for. Den selger ingen kanaler og leverer ingen — den gjør bare de du har hyggelige å se på."
          }
        }
      }
    },
    "intro.2.top": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ONE LINK"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "ÉN LENKE"
          }
        }
      }
    },
    "intro.2.bottom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "IS ALL IT TAKES."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "ER ALT SOM SKAL TIL."
          }
        }
      }
    },
    "intro.2.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your provider gave you a link when you signed up — usually by email, and often called an M3U link or an Xtream login. Find it, and Kanal handles the rest: channels, films, series and the TV guide, sorted on their own."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Leverandøren din ga deg en lenke da du tegnet abonnement — som regel på e-post, ofte kalt M3U-lenke eller Xtream-innlogging. Finn den, så ordner Kanal resten: kanaler, filmer, serier og TV-guiden, sortert av seg selv."
          }
        }
      }
    },
    "intro.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsett"
          }
        }
      }
    },
    "intro.skip": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have my link"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har lenken min"
          }
        }
      }
    },
