    "code.set.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أربعة أرقام، لحماية الملامح والأماكن."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire cifre for at beskytte profiler og indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier Ziffern, um Profile und Einstellungen zu schützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four digits, to protect profiles and settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro dígitos, para proteger perfiles y configuraciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Neljä numeroa, suojaamaan profiileja ja asetuksia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre chiffres, pour protéger les profils et les paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quattro cifre, per proteggere profili e impostazioni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fire siffer, som beskytter profiler og innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vier cijfers, om profielen en instellingen te beschermen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cztery cyfry, aby chronić profile i ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatro dígitos, para proteger perfis e configurações."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fyra siffror för att skydda profiler och inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil ve ayarları korumak için dört haneli."
          }
        }
