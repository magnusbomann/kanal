    "filter.noResults.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابعد واحدة وسيكون هناك المزيد للاختيار من."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern én, så er der flere at vælge imellem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen Sie einen und es werden mehr zur Auswahl stehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove one and there will be more to choose from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina uno y habrá más para elegir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista yksi ja on enemmän valita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez-en un et il y en aura d’autres parmi lesquels choisir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi uno e ci saranno altri tra cui scegliere."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjern ett, så blir det mer å velge i."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijder er één en er zullen er meer te kiezen uit zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń jeden i będzie więcej do wyboru."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova um e haverá mais para escolher."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort en och det finns fler att välja mellan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tanesini kaldırın ve arasından seçim yapabileceğiniz daha fazlası olacaktır."
          }
        }
      }
    },
