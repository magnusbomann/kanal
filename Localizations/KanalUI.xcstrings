    "stream.waiting.body": {
      "extractionState": "manual",
      "comment": "Live stream selection and recovery",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your stream is kept. Playback resumes when the connection returns."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Streamen beholdes. Avspillingen fortsetter når nettet er tilbake."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din ström behålls. Uppspelningen fortsätter när anslutningen är tillbaka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din stream beholdes. Afspilningen fortsætter, når forbindelsen er tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Stream bleibt ausgewählt. Die Wiedergabe wird fortgesetzt, sobald die Verbindung wieder verfügbar ist."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre flux est conservé. La lecture reprend au retour de la connexion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mantiene tu transmisión. La reproducción continuará cuando vuelva la conexión."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua transmissão é mantida. A reprodução continua quando a conexão voltar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il flusso viene mantenuto. La riproduzione riprende al ritorno della connessione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je stream blijft geselecteerd. Het afspelen gaat verder zodra de verbinding terug is."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valittu suoratoisto säilytetään. Toisto jatkuu, kun yhteys palautuu."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój strumień zostaje zachowany. Odtwarzanie zostanie wznowione po przywróceniu połączenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayın seçiminiz korunur. Bağlantı geri geldiğinde oynatma devam eder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الاحتفاظ بالبث الذي اخترته. يُستأنف التشغيل عند عودة الاتصال."
          }
        }
      }
    },
