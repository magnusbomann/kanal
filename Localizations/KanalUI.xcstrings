          }
        }
      }
    },
    "support.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك هذا عندما يساعدك شخص ما مع Kanal إنه يصف ما فشل بدون كشف ما تشاهده"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del dette, når nogen hjælper dig med Kanal. Det beskriver, hvad der mislykkedes, uden at afsløre, hvad du ser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie dies, wenn Ihnen jemand bei Kanal hilft. Es beschreibt, was fehlgeschlagen ist, ohne zu verraten, was Sie ansehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share this when someone is helping you with Kanal. It describes what failed without exposing what you watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte esto cuando alguien te esté ayudando con Kanal. Describe lo que falló sin exponer lo que ves."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Jaa tämä, kun joku auttaa Kanalin kanssa. Se kuvaa epäonnistumista paljastamatta näkemääsi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez ceci lorsque quelqu'un vous aide avec Kanal. Il décrit ce qui a échoué sans exposer ce que vous regardez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi questo quando qualcuno ti sta aiutando con Kanal. Descrive cosa è fallito senza esporre ciò che guardi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Del denne når noen hjelper deg med Kanal. Den beskriver feilen uten å avsløre hva du ser på."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel dit wanneer iemand je helpt met Kanal. Het beschrijft wat is misgegaan zonder te onthullen wat je bekijkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podziel się tym, kiedy ktoś pomaga ci z Kanal. Opisuje to, co zawiodło bez ujawniania tego, co oglądasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe isso quando alguém estiver ajudando você com Kanal. Descreve o que falhou sem expor o que você assiste."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela detta när någon hjälper dig med Kanal. Det beskriver vad som misslyckades utan att avslöja vad du tittar på."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birisi size Kanal ile yardımcı olduğunda bunu paylaşın. İzlediğiniz şeyi ortaya koymadan neyin başarısız olduğunu açıklar."
          }
        }
      }
    },
    "support.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ولم تُدرَج قط الصلات، وأسماء المستخدمين، وكلمات السر، وأسماء البيانات، والألقاب، وتاريخ المراقبة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, brugernavne, adgangskoder, profildnavne, titler og seerhistorik er aldrig inkluderet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, Benutzernamen, Passwörter, Profilnamen, Titel und Anzeigengeschichte sind niemals enthalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, usernames, passwords, profile names, titles and watch history are never included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se incluyen enlaces, nombres de usuario, contraseñas, nombres de perfil, títulos e historial de reproducciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Linkit, käyttäjätunnukset, salasanat, profiilin nimet, otsikot ja katsella historia eivät koskaan sisälly."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens, noms d'utilisateur, mots de passe, noms de profil, titres et historique de surveillance ne sont jamais inclus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Link, nomi utente, password, nomi dei profili, titoli e cronologia di visualizzazione non sono mai inclusi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenker, brukernavn, passord, profilnavn, titler og seerhistorikk tas aldri med."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, gebruikersnamen, wachtwoorden, profielnamen, titels en kijkgeschiedenis zijn nooit inbegrepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Linki, nazwy użytkowników, hasła, nazwy profilu, tytuły i historia oglądania nigdy nie są zawarte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links, nomes de usuário, senhas, nomes de perfis, títulos e histórico de exibição nunca são incluídos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Länkar, användarnamn, lösenord, profilsnamn, titlar och tittarhistorik ingår aldrig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantılar, kullanıcı adları, şifreler, profil isimleri, başlıklar ve izleme geçmişi asla dahil edilmez."
          }
        }
      }
    },
