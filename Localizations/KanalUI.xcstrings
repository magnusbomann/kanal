    },
    "welcome.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is a player. It does not provide or host any channels — bring the subscription you already pay for."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er en avspiller. Den leverer ingen kanaler selv — ta med abonnementet du allerede betaler for."
          }
        }
      }
    },
    "welcome.handoff.action": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up from my phone"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett opp fra telefonen"
          }
        }
      }
    },
    "welcome.handoff.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faster than typing with the remote. Or paste the link below."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Raskere enn å taste med fjernkontrollen. Eller lim inn lenken nedenfor."
