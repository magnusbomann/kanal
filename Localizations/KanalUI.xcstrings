    "detail.noInfo": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء معروف حول هذا العنوان ما يسمونه مقدمك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er intet kendt om denne titel ud over, hvad din udbyder har kaldt den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über diesen Titel ist nichts bekannt, außer was Ihr Anbieter ihn genannt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is known about this title beyond what your provider called it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sabe nada sobre este título más allá de cómo lo llamó su proveedor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tästä tittelistä ei tiedetä muuta kuin se, mitä palveluntarjoajasi kutsui sitä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "On ne sait rien de ce titre au-delà du nom que votre fournisseur lui a donné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si sa nulla di questo titolo oltre a come l'ha chiamato il tuo fornitore."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi vet ingenting om denne tittelen utover navnet leverandøren din ga den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets bekend over deze titel behalve wat uw provider het heeft genoemd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest znane z tego tytułu poza tym, co twój dostawca nazwał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada se sabe sobre este título além do nome do seu provedor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting är känt om denna titel utöver vad din leverantör kallade den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu başlık hakkında sağlayıcınızın adlandırdığı şey dışında hiçbir şey bilinmemektedir."
          }
        }
      }
    },
