    "handoff.camera.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل التسليم بقراءة الرمز على شاشة التلفزيون الخاصة بك. السماح بدخول الكاميرا في ستينغز، ثم العودة."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Overførslen fungerer ved at læse koden på dit tv-skærm. Tillad adgang til kameraet i Indstillinger, og kom derefter tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übergabe funktioniert, indem der Code auf Ihrem Fernsehbildschirm gelesen wird. Geben Sie den Kamerazugriff in den Einstellungen frei und kehren Sie dann zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff works by reading the code on your TV screen. Allow camera access in Settings, then come back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff funciona leyendo el código en la pantalla de su televisor. Permita el acceso a la cámara en Configuración y luego regrese."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luovutus toimii lukemalla koodin televisioruudulta. Salli kameran käyttö Asetuksissa ja tule sitten takaisin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff fonctionne en lisant le code sur l'écran de votre téléviseur. Autorisez l'accès à la caméra dans Paramètres, puis revenez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il passaggio di consegne funziona leggendo il codice sullo schermo della tua TV. Consenti l'accesso alla fotocamera nelle Impostazioni, quindi torna indietro."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Overleveringen fungerer ved å lese koden på TV-skjermen. Gi tilgang til kameraet i Innstillinger, og kom tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff werkt door de code op je tv-scherm te lezen. Geef camera-toegang toe in Instellingen en kom dan terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff działa czytając kod na ekranie telewizora. Pozwól na dostęp do kamery w Ustawieniach, a następnie wróć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O handoff funciona lendo o código na tela da sua TV. Permita o acesso à câmera em Configurações e depois volte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Handoff fungerar genom att läsa koden på din TV-skärm. Tillåt åtkomst till kameran i Inställningar och kom sedan tillbaka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devrişim, TV ekranındaki kodu okuyarak çalışır. Ayarlar'da kamera erişimine izin verin, ardından geri dönün."
          }
        }
      }
    },
