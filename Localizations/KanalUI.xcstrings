          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En voksenprofil ser alt fra TV-tjenesten din."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een profiel voor volwassenen ziet alles van uw tv-service."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil dorosłych widzi wszystko z twojej telewizji."
          }
        },
        "pt-BR": {
          "stringUnit": {
