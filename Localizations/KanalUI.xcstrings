    "handoff.settingsHint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Kanal على Apple TV وصوب الكاميرا على الرمز الذي تظهره لا شيء يترك شبكة منزلك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Kanal på Apple TV, og peg din kamera mod den kode, den viser. Intet forlader dit hjemmenetværk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Kanal auf dem Apple TV und richten Sie Ihre Kamera auf den Code, den es anzeigt. Nichts verlässt Ihr Heimnetzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Kanal on the Apple TV and point your camera at the code it shows. Nothing leaves your home network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Kanal en el Apple TV y apunte su cámara al código que muestra. Nada sale de tu red doméstica."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Kanal Apple TV:ssä ja osoita kameralla koodia. Mikään ei poistu kotiverkostasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Kanal sur le Apple TV et pointez votre appareil photo vers le code qu'il affiche. Rien ne quitte votre réseau domestique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Kanal su Apple TV e punta la fotocamera sul codice che mostra. Niente lascia la tua rete domestica."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Kanal på Apple TV og rett kameraet mot koden den viser. Ingenting forlater hjemmenettet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Kanal op de Apple TV en richt je camera op de code die het toont. Niets verlaat je thuisnetwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Kanal na Apple TV i skieruj kamerę na kod, który pokazuje. Nic nie opuszcza twojej sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Kanal no Apple TV e aponte sua câmera para o código que ele mostra. Nada sai da sua rede doméstica."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Kanal på Apple TV och peka kameran mot koden som visas. Ingenting lämnar ditt hemmarnätverk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV'de Kanal'yi açın ve kameranızı gösterdiği kodu işaretleyin. Hiçbir şey ev ağınızdan ayrılmaz."
          }
        }
      }
    },
