    "profiles.withheldByRating.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه في قسم وافقت عليه، ولكن معدلها أعلى من الحد. ضع واحداً ليدعه يمر على أي حال"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse er i en sektion, du har godkendt, men vurderet højere end grænsen. Kryds et felt for at lade dem komme igennem alligevel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese befinden sich in einem Abschnitt, den Sie genehmigt haben, aber über dem Limit bewertet wurden. Markieren Sie eine, um sie trotzdem durchzulassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are in a section you approved, but rated above the limit. Tick one to let it through anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos están en una sección que usted aprobó, pero calificó por encima del límite. Marque una para dejarlo pasar de todos modos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nämä ovat hyväksymässäsi osiossa, mutta arvo on yli rajan. Valitse yksi päästämään se silti läpi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'agit d'une section que vous avez approuvée, mais dont la note est supérieure à la limite. Cochez-en un pour le laisser passer quand même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi sono in una sezione che hai approvato, ma valutati al di sopra del limite. Spunta una per farli passare comunque."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse ligger i en kategori du har godkjent, men er merket over grensen. Huk av for å slippe dem gjennom likevel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze staan in een sectie die u hebt goedgekeurd, maar hoger is beoordeeld dan de limiet. Vink er een aan om het toch door te laten gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Są one w zatwierdzonej sekcji, ale oceniane powyżej limitu. I tak go przepuść."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles estão em uma seção que você aprovou, mas com classificação acima do limite. Marque um para deixá-lo passar de qualquer maneira."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa är i en sektion som du godkänt, men som har betygsatts högre än gränsen. Kryssa ett för att låta den gå igenom ändå."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar onayladığınız bir bölümdedir, ancak sınırın üzerinde derecelendirilmiştir. Her neyse geçmesine izin vermek için birini işaretleyin."
          }
        }
      }
    },
