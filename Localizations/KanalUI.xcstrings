    "settings.dataQuality.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal عملت حول هذه. إنها أخطاء في الملفات التي أرسلها مزودك لا شيء يمكن أن يصلحه التطبيق في المصدر"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal har arbejdet rundt om disse problemer. De er fejl i de filer, din udbyder har sendt, ikke noget, appen kan rette i kilden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal hat diese umgangen. Es sind Fehler in den Dateien, die Ihr Anbieter gesendet hat, nicht etwas, das die App an der Quelle beheben kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal worked around these. They're faults in the files your provider sent, not something the app can fix at the source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal solucionó estos problemas. Son fallas en los archivos que envió su proveedor, no algo que la aplicación pueda solucionar en el origen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal työskenteli näiden parissa. Ne ovat vikoja palveluntarjoajasi lähettämissä tiedostoissa, joita sovellus ei voi korjata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal a contourné ces problèmes. Il s'agit de défauts dans les fichiers envoyés par votre fournisseur, et non de quelque chose que l'application peut corriger à la source."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal ha lavorato intorno a questi. Sono difetti nei file inviati dal tuo fornitore, non qualcosa che l'app può risolvere alla fonte."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal jobbet seg rundt dette. Det er feil i filene leverandøren din sendte, ikke noe appen kan rette ved kilden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal heeft hieromheen gewerkt. Het zijn fouten in de bestanden die uw provider heeft verzonden, niet iets dat de app aan de bron kan oplossen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal pracował wokół nich. To błędy w plikach wysłanych przez dostawcę, a nie coś, co aplikacja może naprawić u źródła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal contornou isso. São falhas nos arquivos enviados pelo seu provedor, e não algo que o aplicativo possa corrigir na fonte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal har kringgått dessa problem. De är fel i filerna som din leverantör skickade, inte något som appen kan åtgärda i källkoden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal bunlardan etrafını dolaştı. Bunlar sağlayıcınızın gönderdiği dosyalarındaki hatalardır, uygulamanın kaynağında düzeltebileceği bir şey değildir."
          }
        }
      }
    },
