    "rename.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal اسم خدمة تلفزيونية بعد ما جاء منها. سمّه ما هو منطقي بالنسبة لك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal navngiver en tv-tjeneste efter hvor den kommer fra. Giv den et navn, der giver mening for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal nennt einen Fernsehsender nach seinem Ursprung. Nennen Sie ihn, was Ihnen Sinn macht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal names a TV service after where it came from. Call it whatever makes sense to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal nombra un servicio de televisión según su origen. Llámelo como tenga sentido para usted."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal nimeää tv-palvelun. Kutsu sitä miksi haluat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal nomme un service de télévision d'après son origine. Appelez-le comme vous le souhaitez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal chiama un servizio televisivo dopo da dove proviene. Chiamalo come vuoi che abbia senso per te."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal navngir en TV-tjeneste etter hvor den kom fra. Kall den det som gir mening for deg."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal noemt een tv-service naar waar het vandaan komt. Noem het wat je maar wilt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal nadaje nazwę stacji telewizyjnej po tym, skąd pochodzi. Nazwij to jak chcesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal nomeia um serviço de TV de acordo com sua origem. Chame-o do que fizer sentido para você."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal döper en TV-tjänst efter var den kommer ifrån. Kalla den vad som helst som känns logiskt för dig."
