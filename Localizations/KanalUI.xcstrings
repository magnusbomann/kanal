    "search.noResults.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرب رسائل أقل الرؤى وأوامر الكلمات لا تهم"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv færre bogstaver. Akenter og ordrækkefølge betyder ikke noget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Versuchen Sie weniger Buchstaben. Akzente und Wortstellung sind nicht wichtig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try fewer letters. Accents and word order don't matter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruebe con menos letras. Los acentos y el orden de las palabras no importan."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kokeile vähemmän kirjeitä. Aksenteilla ja sanalla ei ole väliä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez moins de lettres. Les accents et l’ordre des mots n’ont pas d’importance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova con meno lettere. Gli accenti e l'ordine delle parole non contano."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Prøv færre bokstaver. Aksenter og ordrekkefølge spiller ingen rolle."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Probeer minder letters. Accenten en woordvolgorde zijn niet belangrijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj mniej liter. Wypadki i słowo nie mają znaczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente menos letras. Acentos e ordem das palavras não importam."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Försök med färre bokstäver. Accenter och ordning spelar ingen roll."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha az harf deneyin. Vurgular ve kelime sırası önemli değildir."
          }
        }
      }
    },
