    "licenses.relink": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit is licensed under the LGPL. يحق لك الحصول على مصدره وتعديله واستخدام بنائك الخاص به مع هذا التطبيق. أكتب إلينا وسنقدم ما تحتاج إليه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit er licenseret under LGPL. Du har ret til at få fat i kildekoden, ændre den og bruge din egen version med denne app. Skriv til os, så giver vi dig det, du har brug for for at gøre det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit ist unter der LGPL lizenziert. Sie haben das Recht, seine Quellcode zu erhalten, ihn zu modifizieren und Ihre eigene Version davon mit dieser App zu verwenden. Schreiben Sie uns, und wir werden Ihnen sagen, was Sie tun müssen, um dies zu tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit is licensed under the LGPL. You are entitled to obtain its source, modify it, and use your own build of it with this app. Write to us and we will provide what you need to do so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "VLC Kit tiene licencia LGPL. Tiene derecho a obtener su fuente, modificarla y utilizar su propia versión con esta aplicación. Escríbenos y te facilitaremos lo necesario para ello."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit on lisensoitu LGPL:n nojalla. Sinulla on oikeus hankkia sen lähde, muokata sitä, ja käyttää omaa rakentaa sitä tällä sovelluksella. Kirjoita meille, niin annamme mitä tarvitset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VLC Kit est sous licence LGPL. Vous avez le droit d'obtenir sa source, de la modifier et d'en utiliser votre propre version avec cette application. Écrivez-nous et nous vous fournirons ce dont vous avez besoin pour le faire."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit è concesso in licenza secondo la LGPL. Hai il diritto di ottenere la sua sorgente, modificarla e utilizzare la tua versione personalizzata con questa app. Scrivici e ti forniremo ciò di cui hai bisogno per farlo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit er lisensiert under LGPL. Du har rett til å hente kildekoden, endre den, og bruke din egen versjon av den sammen med denne appen. Ta kontakt, så gir vi deg det du trenger for å gjøre det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit is gelicentieerd onder de LGPL. U heeft recht op het verkrijgen van de broncode, het wijzigen ervan en het gebruik van uw eigen versie ervan met deze app. Schrijf ons en wij zullen u voorzien van wat u nodig hebt om dit te doen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit jest licencjonowany na licencji LGPL. Masz prawo do uzyskania źródła, modyfikacji i korzystania z własnej budowy z tej aplikacji. Napisz do nas, a zapewnimy ci to, co musisz zrobić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "VLC Kit é licenciado sob a LGPL. Você tem o direito de obter sua fonte, modificá-la e usar sua própria versão com este aplicativo. Escreva-nos e forneceremos o que você precisa para fazê-lo."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit är licensierat under LGPL. Du har rätt att få tillgång till källkoden, modifiera den och använda din egen version med den här appen. Skriv till oss så hjälper vi dig med vad du behöver göra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit LGPL kapsamında lisanslanmıştır. Kaynaklarını edinme, onu değiştirme ve bu uygulamayla kendi sürümünü kullanma hakkına sahipsiniz. Bize yazın ve bunu yapmak için yapmanız gerekenleri sağlayacağız."
          }
        }
      }
    },
