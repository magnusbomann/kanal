    "sync.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الخدمات التلفزيونية والملفات والمفضلات والتقدم تبقى خاصة في حساب التفاح (استخدم تفاصيل الإشارة (آيكلود كيشاين"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-tjenester, profiler, favoritter og fremskridt forbliver private i din Apple-konto. Loginoplysninger bruger iCloud-nøglekæden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fernsehsendungen, Profile, Favoriten und Fortschritte bleiben in Ihrem Apple-Konto privat. Anmeldedaten werden über den iCloud-Schlüsselbund verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TV services, profiles, favourites and progress stay private in your Apple account. Sign-in details use iCloud Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servicios de TV, los perfiles, los favoritos y el progreso permanecen privados en su cuenta de Apple. Los detalles de inicio de sesión utilizan iCloud Keychain."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-palvelut, profiilit, suosikit ja edistys pysyvät yksityisinä Apple-tililläsi. Kirjautumistiedot käyttävät iCloud Keychainia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les services TV, les profils, les favoris et la progression restent privés dans votre compte Apple. Les détails de connexion utilisent le trousseau iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I servizi TV, i profili, i preferiti e i progressi rimangono privati nel tuo account Apple. I dettagli di accesso utilizzano il portachiavi iCloud."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-tjenester, profiler, favoritter og fremdrift lagres privat i Apple-kontoen. Innlogging bruker iCloud-nøkkelring."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-services, profielen, favorieten en voortgang blijven privé in uw Apple-account. Inloggegevens gebruiken iCloud Keychain."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługi telewizyjne, profile, ulubione i postęp pozostają prywatne na koncie Apple. Sygnał w szczegółach używać iCloud Keychain."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviços de TV, perfis, favoritos e progresso permanecem privados na sua conta Apple. Os detalhes de login usam o iCloud Keychain."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TV-tjänster, profiler, favoriter och framsteg förblir privata i ditt Apple-konto. Inloggningsuppgifter använder iCloud-nyckelringen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TV hizmetleri, profiller, favoriler ve ilerleme Apple hesabınızda gizli kalır. Giriş bilgileri iCloud Anahtarlık'ı kullanır."
          }
        }
      }
    },
