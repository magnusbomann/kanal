    "handoff.aim": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقطة في الرمز على تلفازك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pege på koden på dit fjernsyn."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigen Sie auf den Code auf Ihrem Fernseher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point at the code on your TV"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Señala el código de tu televisor"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoita koodia televisiossasi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez le code sur votre téléviseur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica il codice sulla tua TV"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Rett kameraet mot koden på TV-en"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Punt op de code op je tv"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskaż na kod w TV"
          }
        },
        "pt-BR": {
