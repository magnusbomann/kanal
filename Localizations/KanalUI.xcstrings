    "code.enter.message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكبار يجب أن يؤكدوا هذا"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette skal bekræftes af en voksen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Erwachsener muss dies bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A grown-up has to confirm this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adulto tiene que confirmarlo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aikuisen on vahvistettava tämä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il faudra qu'un adulte le confirme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adulto deve confermare questo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En voksen må bekrefte dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een volwassene moet dit bevestigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorośli muszą to potwierdzić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adulto tem que confirmar isso."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta måste bekräftas av en vuxen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu yetişkin birinin doğrulamasını yapması gerekir."
          }
        }
      }
    },
    "code.enter.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast koden"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie den Code ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna koodi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez le code"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv inn koden"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de code in"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadź kod"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange koden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodu girin"
          }
        }
      }
    },
    "code.footer.set": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشفرة مطلوبة لترك ملف الطفل أو تغيير البيانات أو الأماكن المفتوحة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden er nødvendig for at forlade et barns profil, ændre profiler eller åbne indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist erforderlich, um das Profil eines Kindes zu verlassen, Profile zu ändern oder Einstellungen zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code is needed to leave a child's profile, change profiles, or open settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código es necesario para abandonar el perfil de un niño, cambiar perfiles o abrir configuraciones."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodia tarvitaan lapsen profiilin, muutosprofiilien tai avointen asetusten jättämiseksi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code est nécessaire pour quitter le profil d'un enfant, modifier le profil ou ouvrir les paramètres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice è necessario per lasciare il profilo di un bambino, modificare i profili o aprire le impostazioni."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden kreves for å gå ut av en barneprofil, endre profiler eller åpne innstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De code is nodig om het profiel van een kind te verlaten, profielen te wijzigen of instellingen te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod jest potrzebny do pozostawienia profilu dziecka, zmiany profilu lub ustawień otwartych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código é necessário para sair do perfil de uma criança, alterar perfis ou abrir configurações."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För att lämna ett barns profil, ändra profiler eller öppna inställningar krävs koden."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çocuğun profilini bırakmak, profilleri değiştirmek veya ayarları açmak için kod gereklidir."
          }
        }
      }
    },
    "code.footer.unset": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون شفرة، يمكن للطفل أن يتحول إلى أي ملف شخصي نفسه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden en kode kan et barn selv skifte til ethvert profil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne einen Code kann ein Kind selbst zu jedem Profil wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a code, a child can switch to any profile themselves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin un código, un niño puede cambiar él mismo a cualquier perfil."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman koodia lapsi voi vaihtaa mihin tahansa profiiliin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans code, un enfant peut passer lui-même à n’importe quel profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un codice, un bambino può passare a qualsiasi profilo da solo."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten en kode kan et barn selv bytte til hvilken som helst profil."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder een code kan een kind zelf naar elk profiel overstappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kodu dziecko może przejść na dowolny profil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem um código, uma criança pode mudar para qualquer perfil sozinha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan en kod kan ett barn själv byta till vilket profil som helst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kod olmadan, bir çocuk kendi başına herhangi bir profile geçebilir."
          }
        }
      }
    },
