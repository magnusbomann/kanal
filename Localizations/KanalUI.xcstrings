    "detect.needsCredentials %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ يبدو كمقدم Xtream Kanal يحتاج إلى اسم المستخدم وكلمة السر."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ser ud til at være en Xtream-udbyder. Kanal har brug for brugernavn og adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sieht aus wie ein Xtream-Anbieter. Kanal benötigt den Benutzernamen und das Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ looks like an Xtream provider. Kanal needs the username and password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parece un proveedor Xtream. Kanal necesita el nombre de usuario y la contraseña."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ näyttää Xtream-palveluntarjoajalta. Kanal tarvitsee käyttäjätunnuksen ja salasanan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ressemble à un fournisseur Xtream. Kanal a besoin du nom d'utilisateur et du mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sembra un fornitore Xtream. Kanal necessita dell'username e della password."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ser ut som en Xtream-leverandør. Kanal trenger brukernavn og passord."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lijkt op een Xtream-provider. Kanal heeft het gebruikersnaam en wachtwoord nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wygląda na dostawcę Xtream. Kanal potrzebuje nazwy użytkownika i hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se parece com um provedor Xtream. Kanal precisa do nome de usuário e senha."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verkar vara en Xtream-leverantör. Kanal behöver användarnamnet och lösenordet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir Xtream sağlayıcısına benziyor. Kanal kullanıcı adı ve şifreye ihtiyaç duyuyor."
          }
        }
      }
    },
    "detect.pastedText": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يبدو صحيحاً Kanal سيأخذها من هنا"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser rigtigt ud. Kanal tager det videre herfra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht richtig aus. Kanal wird es von hier aus weiterführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That looks right. Kanal will take it from here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eso parece correcto. Kanal se encargará de esto desde aquí."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo näyttää oikealta. Kanal jatkaa tästä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela semble vrai. Kanal s'en chargera à partir d'ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra giusto. Kanal si occuperà da qui."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette ser riktig ut. Kanal tar det herfra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat ziet er goed uit. Kanal zal het vanaf hier oppakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wygląda dobrze. Kanal zajmie się tym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso parece certo. Kanal cuidará disso a partir daqui."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser bra ut. Kanal tar över från och med nu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu doğru görünüyor. Kanal bundan sonra devralacak."
          }
        }
      }
    },
