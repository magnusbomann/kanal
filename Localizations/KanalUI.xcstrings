            "state": "translated",
            "value": "View source"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Se kildekoden"
          }
        }
      }
    },
    "licenses.relink": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit is licensed under the LGPL. You are entitled to obtain its source, modify it, and use your own build of it with this app. Write to us and we will provide what you need to do so."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VLCKit er lisensiert under LGPL. Du har rett til å hente kildekoden, endre den, og bruke din egen versjon av den sammen med denne appen. Ta kontakt, så gir vi deg det du trenger for å gjøre det."
          }
        }
      }
    },
    "credit.vlc.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the film and series formats Apple's own player cannot open, such as MKV."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiller av film- og serieformatene Apples egen spiller ikke kan åpne, som MKV."
          }
        }
      }
    },
    "credit.wikidata.purpose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets you search for a film by the name you know it by, whatever language your provider used."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lar deg søke etter en film med navnet du kjenner den som, uansett hvilket språk leverandøren brukte."
          }
        }
      }
    }
  },
  "version": "1.0"
}
