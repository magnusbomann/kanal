    "search.empty.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القنوات والأفلام والسلسلات في آن واحد العناوين في لغتك تعمل أيضاً صنف الاسم الذي تعرفه"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanaler, film og serier på én gang. Titler på dit eget sprog fungerer også - skriv navnet, du kender det ved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanäle, Filme und Serien auf einmal. Titel in Ihrer eigenen Sprache funktionieren auch - geben Sie den Namen ein, den Sie ihn kennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Channels, films and series at once. Titles in your own language work too — type the name you know it by."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Canales, películas y series a la vez. Los títulos en tu propio idioma también funcionan: escribe el nombre por el que lo conoces."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanavat, elokuvat ja sarjat kerralla. Tittelit omalla kielelläsi toimivat liian kirjoittaa nimi tiedät sen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaînes, films et séries à la fois. Les titres dans votre propre langue fonctionnent également : saisissez le nom sous lequel vous le connaissez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Canali, film e serie contemporaneamente. Anche i titoli nella tua lingua funzionano: digita il nome che conosci."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanaler, filmer og serier på én gang. Titler på ditt eget språk fungerer også — skriv navnet du kjenner den som."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalen, films en series tegelijkertijd. Titels in uw eigen taal werken ook - typ de naam die u ervan kent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanały, filmy i serie naraz. Tytuły w twoim własnym języku również - wpisz nazwę, którą znasz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Canais, filmes e séries de uma só vez. Os títulos em seu próprio idioma também funcionam – digite o nome pelo qual você os conhece."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanaler, filmer och serier samtidigt. Titel på ditt eget språk fungerar också – skriv in namnet du känner till det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birden fazla kanal, film ve dizi. Kendi dilinizdeki başlıklar da işe yarar - bildiğiniz adıyla yazın."
          }
        }
      }
    },
