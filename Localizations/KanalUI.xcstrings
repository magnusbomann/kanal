    "profiles.isAdult.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شخص بالغ يرى كل شيء من خدماتك التلفزيونية"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et profil for voksne viser alt fra dit TV-abonnement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Profil für Erwachsene sieht alles von Ihrem Fernsehdienst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An adult profile sees everything from your TV service."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un perfil adulto ve todo desde tu servicio de TV."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aikuisprofiili näkee kaiken TV-palvelustasi."
          }
        },
        "fr": {
          "stringUnit": {
