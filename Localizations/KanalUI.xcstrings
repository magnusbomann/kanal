    "welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal works out who your provider is, sorts live TV, films and series on its own, and finds the TV guide without being asked. Nothing to configure."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal finner ut hvem leverandøren din er, sorterer direkte-TV, filmer og serier på egen hånd, og henter TV-guiden uten å bli bedt om det. Ingenting å stille inn."
          }
        }
      }
    },
    "welcome.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is a player. It does not provide or host any channels — bring the subscription you already pay for."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er en avspiller. Den leverer ingen kanaler selv — ta med abonnementet du allerede betaler for."
          }
        }
      }
    },
