    "pro.reassurance": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal يعمل بدون زائدات. لا شيء تشاهده اليوم يذهب بعيدا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal fungerer uden Pluss. Alt, hvad du ser i dag, forsvinder ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal funktioniert ohne Pluss. Nichts, was Sie heute ansehen, geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal works without Pluss. Nothing you watch today goes away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal funciona sin Plus. Nada de lo que ves hoy desaparece."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal toimii ilman plussia. Mikään ei katoa tänään."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
