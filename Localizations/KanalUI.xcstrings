          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OUTRAS FONTES"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ANDRA KÄLLOR"
          }
        },
        "tr": {
          "stringUnit": {
