    "welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal يعمل من هو مقدّمكم، يُصنّفُ تلفزيوناً حيّاً، أفلام وسلسلة لوحده، ويَجِدُ الدليلَ التلفزيونيَ بدون أن يُسأل. لا شيء للتحدي"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal finder ud af, hvem din leverandør er, sorterer live-tv, film og serier selv og finder TV-guiden uden at du behøver at bede om det. Du behøver ikke at konfigurere noget."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal ermittelt, wer Ihr Anbieter ist, sortiert Live-TV, Filme und Serien selbst und findet den TV-Guide, ohne dass Sie darum gebeten werden. Keine Konfiguration erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal works out who your provider is, sorts live TV, films and series on its own, and finds the TV guide without being asked. Nothing to configure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal averigua quién es tu proveedor, clasifica TV en vivo, películas y series por sí solo y encuentra la guía de TV sin que te lo pidan. Nada que configurar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal selvittää, kuka tarjoaja on, lajittelee live-tv:n, elokuvat ja sarjat yksin, ja löytää TV-oppaan kysymättä. Ei mitään konfiguroitavaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal détermine qui est votre fournisseur, trie lui-même la télévision en direct, les films et les séries et trouve le guide TV sans qu'on vous le demande. Rien à configurer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal scopre chi è il tuo fornitore, ordina in modo autonomo TV, film e serie in diretta e trova la guida TV senza essere richiesto. Niente da configurare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal finner ut hvem leverandøren din er, sorterer direkte-TV, filmer og serier på egen hånd, og henter TV-guiden uten å bli bedt om det. Ingenting å stille inn."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal bepaalt wie uw provider is, sorteert live tv, films en series zelf en vindt de tv-gids zonder dat er om gevraagd wordt. Niets te configureren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal pracuje nad tym, kim jest Twój dostawca, sortuje telewizję na żywo, filmy i seriale na własną rękę, i znajduje przewodnik TV bez pytania. Nic do konfigurowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal descobre quem é seu provedor, classifica TV ao vivo, filmes e séries por conta própria e encontra o guia de TV sem ser solicitado. Nada para configurar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal identifierar din leverantör, sorterar live-TV, filmer och serier automatiskt och hittar TV-guiden utan att du behöver ange något. Inga konfigurationer krävs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal sağlayıcınızın kim olduğunu belirler, canlı TV, filmleri ve dizileri kendi başına sıralar ve istenmeden TV kılavuzunu bulur. Konfigürasyon yapmanıza gerek yoktur."
          }
        }
      }
    },
    "welcome.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal هو لاعب. فهو لا يوفر أو يستضيف أي قنوات - تجلب الاشتراك الذي تدفعه بالفعل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er en spiller. Den leverer eller hoster ingen kanaler – medbring blot det abonnement, du allerede betaler for."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal ist ein Spieler. Es bietet oder hostet keine Kanäle - bringen Sie das Abonnement mit, für das Sie bereits bezahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is a player. It does not provide or host any channels — bring the subscription you already pay for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal es un jugador. No proporciona ni aloja ningún canal; traiga la suscripción que ya paga."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal on peluri. Se ei tarjoa tai isännöidä mitään kanavia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal est un joueur. Il ne fournit ni n’héberge aucune chaîne – apportez l’abonnement que vous payez déjà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal è un giocatore. Non fornisce né ospita alcun canale: porta l'abbonamento per cui paghi già."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er en avspiller. Den leverer ingen kanaler selv — ta med abonnementet du allerede betaler for."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is een speler. Het biedt of host geen kanalen - neem het abonnement mee waarvoor u al betaalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal jest graczem. Nie zapewnia ani nie hosta żadnych kanałów - przynieść abonament już zapłacić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal é um jogador. Ele não fornece nem hospeda nenhum canal – traga a assinatura pela qual você já pagou."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal är en spelare. Den tillhandahåller eller är värd för inga kanaler. Ta med prenumerationen du redan betalar för."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal bir oyuncu. Hiçbir kanal sağlamaz veya barındırmaz - zaten ödediğiniz aboneliğinizi getirin."
          }
        }
      }
    },
