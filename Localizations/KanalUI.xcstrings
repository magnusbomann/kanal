    "pro.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفس الـKanal بدون التذكير وكل شيء يحتاجه الأسرة المعيشية"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samme Kanal, uden påmindelserne – og alt, hvad en husholdning behøver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gleiche Kanal, ohne die Erinnerungen - und alles, was ein Haushalt braucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same Kanal, without the reminders — and everything a household needs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo Kanal, sin recordatorios y con todo lo que un hogar necesita."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sama Kanal, ilman muistutuksia ja kaikkea kotitalouden tarvitsee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même Kanal, sans les rappels — et tout ce dont un ménage a besoin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso Kanal, senza i promemoria e tutto ciò di cui una famiglia ha bisogno."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Samme Kanal, uten påminnelsene – og alt en husstand trenger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezelfde Kanal, zonder de herinneringen - en alles wat een huishouden nodig heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam Kanal, bez przypomnienia - i wszystko czego potrzebuje gospodarstwo domowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo Kanal, sem lembretes – e tudo o que uma família precisa."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Precis samma Kanal, utan påminnelser – och allt som en hushåll behöver."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcılar olmadan aynı Kanal ve bir evin ihtiyaç duyduğu her şey."
          }
        }
      }
    },
