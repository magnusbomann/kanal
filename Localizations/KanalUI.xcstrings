    "stream.lock.body": {
      "extractionState": "manual",
      "comment": "Live stream selection and recovery",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The channel will reconnect to your choice without switching streams. Choosing another stream moves the lock."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalen kobler til valget ditt igjen uten å bytte stream. Velger du en annen stream, flyttes låsen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalen återansluter till ditt val utan att byta ström. Väljer du en annan ström flyttas låset."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanalen forbinder igen til dit valg uden at skifte stream. Vælger du en anden stream, flyttes låsen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kanal verbindet sich erneut mit deiner Auswahl, ohne den Stream zu wechseln. Bei einer neuen Auswahl wird diese festgelegt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La chaîne se reconnectera à votre choix sans changer de flux. Choisir un autre flux déplace le verrouillage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El canal se reconectará a tu elección sin cambiar de transmisión. Al elegir otra, se fijará la nueva."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O canal se reconectará à sua escolha sem trocar de transmissão. Ao escolher outra, ela será fixada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il canale si riconnetterà alla tua scelta senza cambiare flusso. Scegliendo un altro flusso, il blocco verrà spostato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het kanaal maakt opnieuw verbinding met je keuze zonder van stream te wisselen. Als je een andere stream kiest, wordt die vastgezet."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanava yhdistää uudelleen valitsemaasi suoratoistoon vaihtamatta sitä. Toisen suoratoiston valitseminen siirtää lukituksen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanał ponownie połączy się z wybranym strumieniem bez jego zmiany. Wybranie innego strumienia przenosi blokadę."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal, yayını değiştirmeden seçiminize yeniden bağlanır. Başka bir yayın seçerseniz kilit ona taşınır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستعيد القناة الاتصال باختيارك دون تبديل البث. عند اختيار بث آخر، ينتقل التثبيت إليه."
          }
        }
      }
    },
