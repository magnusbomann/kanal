          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay guía de televisión"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ei vielä TV-opas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de guide TV"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna guida TV ancora"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen TV-guide ennå"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen tv-gids"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze przewodnika TV"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há guia de TV"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga TV-guider ännu"
          }
        },
        "tr": {
          "stringUnit": {
