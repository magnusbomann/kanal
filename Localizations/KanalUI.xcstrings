          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu provedor recusou isso"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din leverantör har vägrat detta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcınız bunu reddetti"
          }
        }
      }
    },
    "player.server.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف يُحمّل، لكن الخادم لن يخدمه بقطع، لذا لا يوجد شيء للعب أو تجاوزه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen downloades, men serveren serverer den ikke i stykker, så der er intet at afspille eller springe igennem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wird heruntergeladen, aber der Server lädt sie nicht in Teilen, so dass es nichts zu spielen oder zu überspringen gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file downloads, but the server won't serve it in pieces, so there is nothing to play or skip through."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se descarga, pero el servidor no lo entrega en pedazos, por lo que no hay nada que reproducir ni saltar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedosto lataa, mutta palvelin ei palvele sitä palasina, joten ei ole mitään pelattavaa tai ohittaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est téléchargé, mais le serveur ne le servira pas en morceaux, il n'y a donc rien à lire ou à parcourir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file viene scaricato, ma il server non lo serve in pezzi, quindi non c'è niente da riprodurre o saltare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fila lastes ned, men serveren vil ikke levere den i biter, så det er ingenting å spille av eller hoppe i."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand wordt gedownload, maar de server serveert het niet in stukjes, dus er is niets om te spelen of doorheen te springen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik pobiera, ale serwer nie będzie go podawać w kawałkach, więc nie ma nic do gry lub przeskakiwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo é baixado, mas o servidor não o veicula em partes, então não há nada para reproduzir ou pular."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen laddas ner, men servern kan inte spela upp den i delar, så det finns inget att spela eller hoppa över."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya indirilir, ancak sunucu onu parçalara ayırmadan sunmaz, bu nedenle oynanacak veya atlanacak hiçbir şey yoktur."
          }
        }
      }
    },
    "player.server.title": {
