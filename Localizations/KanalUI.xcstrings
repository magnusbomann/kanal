    "licenses.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal مبنية على الأعمال المفتوحة المصدر التي يقوم بها أشخاص آخرون. هذه هي الأجزاء وما يفعلونه وأين يجدونها"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er bygget på open source-arbejde fra andre mennesker. Dette er delene, hvad de gør, og hvor du kan finde dem."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal basiert auf Open-Source-Arbeit anderer Menschen. Dies sind die Teile, was sie tun und wo man sie finden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is built on open-source work by other people. These are the parts, what they do, and where to find them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal se basa en el trabajo de código abierto de otras personas. Estas son las piezas, qué hacen y dónde encontrarlas."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal on rakennettu muiden ihmisten avoimen lähdekoodin työlle. Nämä ovat osat, mitä ne tekevät ja mistä ne löytyvät."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal est construit sur le travail open source d'autres personnes. Voici les pièces, ce qu’elles font et où les trouver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal è costruito su lavori open source di altre persone. Queste sono le parti, cosa fanno e dove trovarle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er bygget på åpen kildekode laget av andre. Her er delene, hva de gjør, og hvor du finner dem."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is gebouwd op open-source werk van andere mensen. Dit zijn de onderdelen, wat ze doen en waar je ze kunt vinden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal jest zbudowany na pracy open-source przez innych ludzi. To są części, to co robią i gdzie je znaleźć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal é baseado no trabalho de código aberto de outras pessoas. Estas são as peças, o que fazem e onde encontrá-las."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal bygger på öppen källkod från andra människor. Här hittar du delarna, vad de gör och var du hittar dem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal, diğer insanların açık kaynaklı çalışmalarına dayanmaktadır. Bunlar parçalar, yaptıkları işler ve onları nerede bulabileceğinizdir."
          }
        }
      }
    },
