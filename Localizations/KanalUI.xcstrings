    "source.repair.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استولي على الرابط الجديد من مزودك مفضلاتك وشاهدوا التاريخ يبقون حيث هم"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt det nye link fra din udbyder. Dine favoritter og seerhistorik forbliver, hvor de er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren Sie den neuen Link von Ihrem Anbieter und fügen Sie ihn ein. Ihre Favoriten und Ihre Anzeigengeschichte bleiben dort, wo sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste the new link from your provider. Your favourites and watch history stay where they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue el nuevo enlace de su proveedor. Tus favoritos y el historial de visualización permanecen donde están."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä uusi linkki palveluntarjoajalta. Suosikkisi ja katsella historiaa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez le nouveau lien de votre fournisseur. Vos favoris et votre historique des vidéos regardées restent là où ils se trouvent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla il nuovo link dal tuo fornitore. I tuoi preferiti e la cronologia delle visualizzazioni rimangono dove sono."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn den nye lenken fra leverandøren. Favoritter og seerhistorikk blir værende."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieer de nieuwe link van uw provider. Uw favorieten en kijkgeschiedenis blijven waar ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej nowy link od dostawcy. Twoje ulubione i oglądać historię pozostać tam, gdzie są."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole o novo link do seu provedor. Seus favoritos e histórico de exibição permanecem onde estão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in den nya länken från din leverantör. Dina favoriter och tittarhistorik förblir där de är."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlayıcınızdan gelen yeni bağlantıyı yapıştırın. Favorileriniz ve izleme geçmişiniz yerinde kalır."
          }
        }
      }
    },
