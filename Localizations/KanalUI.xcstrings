    "profiles.isChild.footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الطفل يرى فقط ما توافق عليه هنا، وليس قسم الكبار. أي شيء لا يستطيع التطبيق التحقق منه يبقى مخبأ"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et barn ser kun det, du godkender her, og aldrig den voksne sektion. Alt, hvad appen ikke kan verificere, forbliver skjult."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kind sieht nur, was Sie hier genehmigen, und nie den Erwachsenenbereich. Alles, was die App nicht überprüfen kann, bleibt versteckt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A child sees only what you approve here, and never the adult section. Anything the app cannot verify stays hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un niño ve sólo lo que usted aprueba aquí, y nunca la sección de adultos. Todo lo que la aplicación no pueda verificar permanece oculto."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapsi näkee vain sen, mitä täällä hyväksytään. Kaikki, mitä sovellus ei voi vahvistaa, pysyy piilossa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enfant ne voit ici que ce que vous approuvez, et jamais la section adulte. Tout ce que l'application ne peut pas vérifier reste caché."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un bambino vede solo ciò che approvi qui, e mai la sezione per adulti. Tutto ciò che l'app non può verificare rimane nascosto."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et barn ser bare det du godkjenner her, og aldri voksendelen. Alt appen ikke kan bekrefte, forblir skjult."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een kind ziet alleen wat je hier goedkeurt, en nooit de volwassen sectie. Alles wat de app niet kan verifiëren blijft verborgen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziecko widzi tylko to, co tu akceptujesz, a nigdy sekcja dla dorosłych. Wszystko, czego aplikacja nie może zweryfikować, pozostaje ukryte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma criança vê apenas o que você aprova aqui, e nunca a seção para adultos. Tudo o que o aplicativo não consegue verificar permanece oculto."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett barn ser bara det du godkänner här, och aldrig den vuxna delen. Allt appen inte kan verifiera förblir doldt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir çocuk yalnızca burada onayladığınız şeyleri görür ve asla yetişkin bölümünü görmez. Uygulama doğrulayamadığı hiçbir şey gizli kalır."
          }
        }
      }
    },
