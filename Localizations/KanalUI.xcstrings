    "home.question": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا تريد أن تشاهد؟"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad vil du se?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was möchtest du sehen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What do you want to watch?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Qué quieres ver?"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitä haluat katsoa?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que veux-tu regarder ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vuoi guardare?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hva vil du se?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wil je kijken?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co chcesz oglądać?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você quer assistir?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad vill du titta på?"
          }
        },
        "tr": {
          "stringUnit": {
