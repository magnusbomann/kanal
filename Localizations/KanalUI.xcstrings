    "profiles.emptyChild.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الكبار يقررون ما يظهر في هذا الملف أطلب منهم إضافة شيء في الصور"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En voksen bestemmer, hvad der vises i denne profil. Bed dem om at tilføje noget i Profiler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Erwachsener entscheidet, was in diesem Profil angezeigt wird. Bitte ihn, etwas in den Profilen hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A grown-up decides what shows up in this profile. Ask them to add something in Profiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adulto decide lo que aparece en este perfil. Pídales que agreguen algo en Perfiles."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Aikuinen päättää, mitä profiilissa näkyy. Pyydä heitä lisäämään jotain profiiliin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adulte décide de ce qui apparaît dans ce profil. Demandez-leur d'ajouter quelque chose dans les profils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un adulto decide cosa appare in questo profilo. Chiedigli di aggiungere qualcosa nelle Profili."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En voksen bestemmer hva som dukker opp i denne profilen. Be dem legge til noe under Profiler."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een volwassene beslist wat er in dit profiel verschijnt. Vraag hen om iets toe te voegen in Profielen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorośli decydują, co pojawia się w tym profilu. Niech dodają coś do Profilów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um adulto decide o que aparece neste perfil. Peça-lhes para adicionar algo em Perfis."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En vuxen bestämmer vad som visas i den här profilen. Be dem lägga till något i Profiler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yetişkin bu profilde neyin görüneceğini kararlaştırır. Onlara Profiller'de bir şeyler eklemelerini isteyin."
          }
        }
      }
    },
