    "guide.missing.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal تبحث عن دليل تلقائيا عندما يتصل بخدماتك التلفزيونية. هذه الخدمة لم تقدم واحدة"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal søger automatisk efter en vejledning, når den opretter forbindelse til dit TV-abonnement. Dette abonnement har ikke leveret en vejledning."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal sucht automatisch nach einem Leitfaden, wenn es sich mit Ihrem Fernsehsender verbindet. Dieser Sender hat keinen bereitgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal looks for a guide automatically when it connects to your TV service. This service hasn't provided one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal busca una guía automáticamente cuando se conecta a su servicio de TV. Este servicio no ha proporcionado ninguno."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal etsii opasta automaattisesti, kun se on yhteydessä TV-palveluun. Tätä palvelua ei ole tarjottu."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal recherche automatiquement un guide lorsqu'il se connecte à votre service TV. Ce service n’en a pas fourni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal cerca automaticamente una guida quando si connette al tuo servizio televisivo. Questo servizio non ne ha fornito una."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal leter etter en guide automatisk når TV-tjenesten kobles til. Denne tjenesten har ikke gitt noen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal zoekt automatisch naar een gids wanneer het verbinding maakt met uw tv-service. Deze service heeft er geen geleverd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal szuka przewodnika automatycznie, gdy łączy się z serwisem telewizyjnym. Ta usługa nie zapewniła żadnej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal procura um guia automaticamente quando se conecta ao seu serviço de TV. Este serviço não forneceu um."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal söker automatiskt efter en guide när den ansluter till din TV-tjänst. Denna tjänst har inte tillhandahållit någon."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal TV hizmetinize bağlandığında otomatik olarak bir kılavuz arar. Bu hizmet henüz bir kılavuz sağlamamıştır."
          }
        }
      }
    },
    "guide.missing.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا دليل تلفزيوني لحد الآن"
          }
        },
        "da": {
