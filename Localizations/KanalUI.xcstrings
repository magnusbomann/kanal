    "player.rejected.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تكون قد انتهت مدة الاشتراك، أو قد تكون بالفعل مشاهدة على أكبر عدد من الأجهزة كما تسمح."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementet kan være udløbet, eller du kan allerede se på det på så mange enheder, som det tillader."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Abonnement ist möglicherweise abgelaufen oder Sie schauen bereits auf so vielen Geräten wie es zulässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The subscription may have expired, or you may already be watching on as many devices as it allows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que la suscripción haya caducado o que ya estés mirando en tantos dispositivos como te permita."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaus on ehkä päättynyt, tai saatat jo katsella niin monta laitetta kuin se sallii."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abonnement a peut-être expiré ou vous regardez peut-être déjà sur autant d'appareils que possible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'abbonamento potrebbe essere scaduto o potresti già guardare su più dispositivi di quanti ne consenta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementet kan ha utløpt, eller du ser kanskje allerede på så mange enheter som det tillater."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het abonnement is mogelijk verlopen, of je bekijkt het al op zoveel apparaten als het toelaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerata może wygasnąć, lub można już oglądać na tyle urządzeń, ile pozwala."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura pode ter expirado ou você já pode estar assistindo em quantos dispositivos ela permitir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationen kan ha löpt ut, eller så tittar du redan på den på så många enheter som den tillåter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelik süresi dolmuş olabilir veya zaten izin verdiği kadar çok cihazda izliyorsunuzdur."
          }
        }
      }
    },
