    "welcome.handoff.hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أسرع من الطباعة مع جهاز التحكم أَو يَعْبرُ الرابطَ أدناه."
          }
        },
        "da": {
          "stringUnit": {
