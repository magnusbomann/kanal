    "settings.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal هو لاعب للمشاركة لديك بالفعل. وهي لا توفر قنوات خاصة بها."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er en spiller for et abonnement, som du allerede har. Den tilbyder ingen egne kanaler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal ist ein Spieler für ein Abonnement, das Sie bereits haben. Es bietet keine eigenen Kanäle an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is a player for a subscription you already have. It provides no channels of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal es un reproductor para una suscripción que ya tienes. No proporciona canales propios."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal on pelaaja tilaus sinulla on jo. Se ei tarjoa omia kanavia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal est un lecteur pour un abonnement que vous possédez déjà. Il ne fournit aucune chaîne propre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal è un giocatore per un abbonamento che hai già. Non fornisce canali propri."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal er en avspiller for et abonnement du allerede har. Den leverer ingen kanaler selv."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal is een speler voor een abonnement dat je al hebt. Het biedt geen eigen kanalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal jest graczem dla abonamentu już masz. Nie zapewnia on własnych kanałów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal é um player para uma assinatura que você já possui. Ele não fornece canais próprios."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal är en spelare för ett prenumeration som du redan har. Den erbjuder inga egna kanaler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal, zaten sahip olduğunuz bir abonelik için bir oyuncu. Kendisi hiçbir kanal sağlamaz."
          }
        }
      }
    },
