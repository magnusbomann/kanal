    "signIn.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تفاصيلك تبقى على هذا الجهاز وترسل فقط لمقدمك"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine oplysninger forbliver på denne enhed og sendes kun til din egen udbyder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Daten bleiben auf diesem Gerät gespeichert und werden nur an Ihren eigenen Anbieter gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your details stay on this device and are sent only to your own provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus datos permanecen en este dispositivo y se envían únicamente a su propio proveedor."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiedot pysyvät tällä laitteella ja lähetetään vain omalle tarjoajalle."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos coordonnées restent sur cet appareil et sont envoyées uniquement à votre propre fournisseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati rimangono su questo dispositivo e vengono inviati solo al tuo fornitore."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Opplysningene dine blir på denne enheten og sendes bare til din egen leverandør."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw gegevens blijven op dit apparaat en worden alleen verzonden naar uw eigen provider."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane pozostają na tym urządzeniu i są wysyłane tylko do własnego dostawcy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dados permanecem neste dispositivo e são enviados apenas para seu próprio provedor."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina uppgifter förblir på denna enhet och skickas endast till din egen leverantör."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Detaylarınız bu cihazda kalır ve yalnızca kendi sağlayıcınıza gönderilir."
          }
        }
      }
    },
