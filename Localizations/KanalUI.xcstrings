    "pairing.body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Kanal على رقمك iPhone، صنبور ستينغز، ثم أرسل إلى Apple TV. ضع الكاميرا على هذا الرمز"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Kanal på din iPhone, tryk på Indstillinger, og send derefter til Apple TV. Hold kameraet rettet mod denne kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Kanal auf Ihrem iPhone, tippen Sie auf Einstellungen und dann auf Senden an Apple TV. Zeigen Sie die Kamera auf diesen Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Kanal on your iPhone, tap Settings, then Send to Apple TV. Point the camera at this code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Kanal en su iPhone, toque Configuración y luego Enviar a Apple TV. Apunte la cámara a este código."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Kanal iPhonessasi, napauta Asetukset ja lähetä sitten Apple TV:hen. Osoita kameralla tätä koodia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Kanal sur votre iPhone, appuyez sur Paramètres, puis sur Envoyer à Apple TV. Pointez la caméra sur ce code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Kanal sul tuo iPhone, tocca Impostazioni, quindi Invia a Apple TV. Puntare la fotocamera a questo codice."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Kanal på iPhone, trykk Innstillinger, så Send til Apple TV. Rett kameraet mot denne koden."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Kanal op uw iPhone, tik op Instellingen en vervolgens Verzenden naar Apple TV. Richt de camera op deze code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Kanal na iPhone, dotknij Ustawienia, a następnie Wyślij do Apple TV. Wskaż kamerę na ten kod."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra Kanal em seu iPhone, toque em Configurações e em Enviar para Apple TV. Aponte a câmera para este código."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna Kanal på din iPhone, tryck på Inställningar och sedan Skicka till Apple TV. Vänd kameran mot denna kod."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'nizde Kanal'yi açın, Ayarlar'a dokunun, ardından Apple TV'ye Gönder'e tıklayın. Kamerayı bu kodun üzerine yönlendirin."
          }
        }
      }
    },
