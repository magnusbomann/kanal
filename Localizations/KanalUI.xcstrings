    "app.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal"
          }
        }
      }
    },
    "welcome.headline.top": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "PASTE THE LINK."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "LIM INN LENKEN."
          }
        }
      }
    },
    "welcome.headline.bottom": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "WE'LL DO THE REST."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "VI GJØR RESTEN."
          }
        }
      }
    },
    "welcome.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal works out who your provider is, sorts live TV, films and series on its own, and finds the TV guide without being asked. Nothing to configure."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal finner ut hvem leverandøren din er, sorterer direkte-TV, filmer og serier på egen hånd, og henter TV-guiden uten å bli bedt om det. Ingenting å stille inn."
          }
        }
      }
    },
    "welcome.field.prompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playlist or provider link"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilleliste- eller leverandørlenke"
          }
        }
      }
    },
    "welcome.action.continue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up Kanal"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sett opp Kanal"
          }
        }
      }
    },
