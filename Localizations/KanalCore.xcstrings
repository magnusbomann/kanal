    "detect.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استلموا رابطاً من القائمة للبدء"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt et link til en spilleliste for at komme i gang."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopieren Sie einen Link zu einer Wiedergabeliste, um mit dem Starten zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste a playlist link to get started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pegue el enlace de una lista de reproducción para comenzar."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liitä soittolistalinkki aloittaaksesi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un lien de playlist pour commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla un link alla playlist per iniziare."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lim inn en spillelistelenke for å komme i gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een playlist-link om aan de slag te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej link do listy odtwarzania, aby rozpocząć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um link de lista de reprodução para começar."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klistra in en spellista-länk för att komma igång."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başlamak için bir çalma listesi bağlantısını yapıştırın."
          }
