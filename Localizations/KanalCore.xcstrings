      }
    },
    "detect.unusable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا لا يبدو وكأنه رابط Kanal يمكن فتحه."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det ser ikke ud til at være en link, som Kanal kan åbne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sieht nicht aus wie ein Link, den Kanal öffnen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That doesn't look like a link Kanal can open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No parece un enlace que Kanal pueda abrir."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuo ei näytä linkiltä, jonka Kanal voi avata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela ne ressemble pas à un lien que Kanal peut ouvrir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo non sembra un link che Kanal possa aprire."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette ser ikke ut som en lenke Kanal kan åpne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat ziet er niet uit als een link die Kanal kan openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To nie wygląda na połączenie Kanal."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não parece um link que Kanal possa abrir."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här ser inte ut som en länk som Kanal kan öppna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, Kanal'nin açabileceği bir bağlantı gibi görünmüyor."
          }
        }
      }
    },
    "error.badResponse": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ذلك الخادم أجاب لكن ليس بطريقة يفهمها Kanal"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den server svarede, men ikke på en måde, som Kanal forstår."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server antwortete, aber nicht auf eine Weise, die Kanal versteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That server answered, but not in a way Kanal understands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese servidor respondió, pero no de una manera que Kanal entienda."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se palvelin vastasi, mutta ei tavalla, jolla Kanal ymmärtää."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur a répondu, mais pas d'une manière que Kanal comprend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel server ha risposto, ma non in un modo che Kanal capisca."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren svarte, men ikke på en måte Kanal forstår."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die server antwoordde, maar niet op een manier die Kanal begrijpt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer odpowiedział, ale nie w sposób Kanal rozumie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse servidor respondeu, mas não da forma que Kanal entende."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern svarade, men inte på ett sätt som Kanal förstår."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O sunucu cevap verdi, ancak Kanal'nin anlayacağı bir şekilde değil."
          }
        }
      }
    },
