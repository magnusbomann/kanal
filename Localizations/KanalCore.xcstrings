    "pairing.mismatch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز لم يتطابق أظهر واحدة جديدة وحاول مرة أخرى"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kode stemte ikke overens. Vis en ny, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Code stimmte nicht überein. Zeigen Sie einen neuen und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That code didn't match. Show a fresh one and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no coincidía. Muestre uno nuevo e inténtelo de nuevo."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Koodi ei täsmännyt. Näytä uusi ja yritä uudelleen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code ne correspondait pas. Montrez-en un nouveau et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel codice non corrispondeva. Mostra uno nuovo e riprova."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Koden stemte ikke. Vis en ny og prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die code paste niet. Toon een nieuwe en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten kod nie pasuje. Pokaż świeży i spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código não correspondeu. Mostre um novo e tente novamente."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna kod stämde inte överens. Visa en ny och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O kod eşleşmedi. Yeni bir tane gösterin ve tekrar deneyin."
          }
        }
      }
    },
    "pairing.notFound": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم أجد ذلك Apple TV فحص كلا الجهازين على نفس الرقم Wi-Fi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg kunne ikke finde Apple TV. Sørg for, at begge enheder er tilsluttet den samme Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konnte das Apple TV nicht finden. Überprüfen Sie, ob beide Geräte auf demselben Wi-Fi sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't find that Apple TV. Check both devices are on the same Wi-Fi."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo encontrar ese Apple TV. Verifique que ambos dispositivos estén en el mismo Wi-Fi."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "En löytänyt Apple TV:tä. Tarkista, että molemmat laitteet ovat samassa Wi-Fissä."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver ce Apple TV. Vérifiez que les deux appareils sont sur le même Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non sono riuscito a trovare quel Apple TV. Controlla che entrambi i dispositivi siano sullo stesso Wi-Fi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ikke Apple TV-en. Sjekk at begge enhetene er på samme Wi-Fi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon dat Apple TV niet vinden. Controleer of beide apparaten op dezelfde Wi-Fi staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mogłem znaleźć Apple TV. Sprawdź oba urządzenia są na tym samym Wi-Fi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar esse Apple TV. Verifique se ambos os dispositivos estão no mesmo Wi-Fi."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple TV kunde inte hittas. Kontrollera att båda enheterna är anslutna till samma Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O Apple TV'yi bulamadım. Her iki cihazın da aynı Wi-Fi'de olduğundan emin olun."
          }
        }
      }
    },
    "pairing.unreadableCode": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الرمز غير قابل للقراءة"
          }
