    "purchase.nothingToRestore": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على أي شراء في وقت سابق على هوية آبل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der er ikke fundet nogen tidligere køb på denne Apple-ID."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurden keine früheren Käufe für diese Apple-ID gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No earlier purchase was found on this Apple ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna compra anterior en este ID de Apple."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ID:stä ei löytynyt aikaisempaa ostoa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat antérieur n'a été trouvé sur cet identifiant Apple."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato trovato alcun acquisto precedente su questo ID Apple."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen tidligere kjøp på denne Apple-kontoen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen eerdere aankoop gevonden op deze Apple ID."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono wcześniejszego zakupu na tym Apple ID."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma compra anterior foi encontrada neste ID Apple."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inga tidigare köp registrerade för den här Apple-ID:n."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Apple Kimliği'nde daha önceki bir satın alma bulunamadı."
          }
        }
      }
    },
    "purchase.unavailable": {
      "extractionState": "manual",
      "localizations": {
