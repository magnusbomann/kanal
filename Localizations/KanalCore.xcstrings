    "player.alternativeEngine.failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا المجرى لن يفتح قد يكون خارج الخط، أو قد يكون مقدمك قد وصل حد اتصاله."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne streaming kunne ikke åbnes. Den er muligvis offline, eller din udbyder har nået sin forbindelsesgrænse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Stream konnte nicht geöffnet werden. Er ist möglicherweise offline oder Ihr Anbieter hat seine Verbindungsgrenze erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This stream wouldn't open. It may be offline, or your provider may have reached its connection limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta transmisión no se abre. Es posible que esté desconectado o que su proveedor haya alcanzado su límite de conexión."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä virta ei aukeaisi. Se voi olla offline, tai palveluntarjoajasi on ehkä saavuttanut sen yhteys rajan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce flux ne s'ouvrirait pas. Il est peut-être hors ligne ou votre fournisseur a peut-être atteint sa limite de connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo flusso non si apre. Potrebbe essere offline, o il tuo provider potrebbe aver raggiunto il limite di connessione."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne strømmen ville ikke åpne. Den kan være nede, eller leverandøren din kan ha nådd grensen for antall tilkoblinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze stream zou niet openen. Het kan offline zijn, of uw provider heeft zijn verbindingslimiet bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten strumień nie chciał się otworzyć. Może być nieaktywny lub Twój dostawca mógł osiągnąć limit połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fluxo não abria. Pode estar offline ou seu provedor pode ter atingido o limite de conexão."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna ström kunde inte öppnas. Den kan vara offline eller din leverantör har nått sin anslutningsgräns."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu akış açılmayacaktır. Çevrimdışı olabilir veya sağlayıcınız bağlantı sınırını aşmış olabilir."
          }
        }
      }
    },
    "profile.defaultOwnerName": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا"
          }
        },
